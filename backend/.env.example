DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://iod_gh:iod_gh@localhost:55432/iod_gh
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
# Resend SMTP: add values from the Resend dashboard. Never commit backend/.env.
DEFAULT_FROM_EMAIL=hello@aduseimedia.codes
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Resend requires this exact SMTP username.
EMAIL_HOST_USER=hello@aduseimedia.codes
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
# Create a Resend API key and keep it only in backend/.env.
EMAIL_HOST_PASSWORD=
DJANGO_ENABLE_ADMIN=true
LOG_LEVEL=INFO
PGADMIN_DEFAULT_EMAIL=hello@aduseimedia.codes
PGADMIN_DEFAULT_PASSWORD=choose-a-strong-local-password
